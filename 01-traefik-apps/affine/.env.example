# affine — plantilla (copiar a .env y completar)

# AFFiNE server + migración
AFFINE_REVISION='stable'
AFFINE_SERVER_EXTERNAL_URL='https://affine.joseluna.dev'
AFFINE_SERVER_HOST='affine.joseluna.dev'
AFFINE_SERVER_HTTPS='true'
AFFINE_INDEXER_ENABLED='false'
PORT='3010'
REDIS_SERVER_HOST='redis'
SELFHOSTED='true'
DEPLOYMENT_TYPE=selfhosted
CONFIG_LOCATION='./self-host/config'
UPLOAD_LOCATION='./self-host/storage'
DB_DATA_LOCATION='./self-host/postgres/pgdata'
MANTICORE_DATA_LOCATION='./self-host/manticore'

# Base de datos (PostgreSQL)
DB_DATABASE='affine'
DB_USERNAME='affine'
DB_PASSWORD=change-me
DATABASE_URL='postgresql://affine:change-me@postgres:5432/affine'
POSTGRES_HOST_AUTH_METHOD='trust'
POSTGRES_INITDB_ARGS='--data-checksums'
