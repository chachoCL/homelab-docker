# outline — plantilla (copiar a .env y completar)

# General
URL='https://outline.joseluna.dev'
PORT='3000'
NODE_ENV='production'
FORCE_HTTPS='true'
DEFAULT_LANGUAGE='en_US'
LOG_LEVEL='info'
DEBUG='http'
ENABLE_UPDATES='true'
WEB_CONCURRENCY='1'
SECRET_KEY=change-me
UTILS_SECRET=change-me

# Base de datos y Redis
DATABASE_URL='postgres://user:change-me@postgres:5432/outline'
PGSSLMODE='disable'
DATABASE_CONNECTION_POOL_MIN='0'
DATABASE_CONNECTION_POOL_MAX='5'
REDIS_URL='redis://redis:6379'

# Almacenamiento (Backblaze B2 / S3)
FILE_STORAGE='s3'
FILE_STORAGE_LOCAL_ROOT_DIR='/var/lib/outline/data'
FILE_STORAGE_UPLOAD_MAX_SIZE='262144000'
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION='us-east-005'
AWS_S3_UPLOAD_BUCKET_URL='https://s3.us-east-005.backblazeb2.com'
AWS_S3_UPLOAD_BUCKET_NAME='outline-joseluna'
AWS_S3_FORCE_PATH_STYLE='true'
AWS_S3_ACL='private'
AWS_S3_UPLOAD_METHOD=put

# OIDC (Pocket ID)
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_AUTH_URI='https://pocket-id.joseluna.dev/authorize'
OIDC_TOKEN_URI='https://pocket-id.joseluna.dev/api/oidc/token'
OIDC_USERINFO_URI='https://pocket-id.joseluna.dev/api/oidc/userinfo'
OIDC_LOGOUT_URI='https://pocket-id.joseluna.dev/api/oidc/end-session'
OIDC_USERNAME_CLAIM='preferred_username'
OIDC_DISPLAY_NAME='Pocket ID'
OIDC_SCOPES='openid profile email'

# SMTP
SMTP_HOST='mail.joseluna.dev'
SMTP_PORT='465'
SMTP_USERNAME='no-reply@joseluna.dev'
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL='no-reply@joseluna.dev'
SMTP_REPLY_EMAIL='no-reply@joseluna.dev'

# Rate limiter
RATE_LIMITER_ENABLED='true'
RATE_LIMITER_REQUESTS='1000'
RATE_LIMITER_DURATION_WINDOW='60'

# Integraciones
SLACK_APP_ID=change-me
SLACK_CLIENT_ID=change-me
SLACK_CLIENT_SECRET=change-me
SLACK_MESSAGE_ACTIONS='true'
SLACK_VERIFICATION_TOKEN=change-me

# PostgreSQL
POSTGRES_DB='outline'
POSTGRES_USER='user'
POSTGRES_PASSWORD=change-me
