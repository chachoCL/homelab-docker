# kaneo — plantilla (copiar a .env y completar)

# URLs públicas
KANEO_CLIENT_URL='https://kaneo.joseluna.dev'
KANEO_API_URL='https://kaneo.joseluna.dev/api'
DOMAIN='kaneo.joseluna.dev'

# Auth
AUTH_SECRET=change-me
DISABLE_GUEST_ACCESS='true'
DISABLE_REGISTRATION='true'

# OIDC (Pocket ID)
CUSTOM_OAUTH_CLIENT_ID=change-me
CUSTOM_OAUTH_CLIENT_SECRET=change-me
CUSTOM_OAUTH_DISCOVERY_URL='https://pocket-id.joseluna.dev/.well-known/openid-configuration'
CUSTOM_OAUTH_AUTHORIZATION_URL='https://pocket-id.joseluna.dev/authorize'
CUSTOM_OAUTH_TOKEN_URL='https://pocket-id.joseluna.dev/api/oidc/token'
CUSTOM_OAUTH_USER_INFO_URL='https://pocket-id.joseluna.dev/api/oidc/userinfo'
CUSTOM_OAUTH_SCOPES='profile,email'

# SMTP
SMTP_HOST='mail.joseluna.dev'
SMTP_PORT='465'
SMTP_SECURE='SSL'
SMTP_USER='no-reply@joseluna.dev'
SMTP_PASSWORD=change-me
SMTP_FROM='no-reply@joseluna.dev'

# PostgreSQL
POSTGRES_DB='kaneo'
POSTGRES_USER='kaneo'
POSTGRES_PASSWORD=change-me
DATABASE_URL='postgresql://kaneo:change-me@postgres:5432/kaneo'
