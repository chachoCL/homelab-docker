# litellm — plantilla (copiar a .env y completar)

# LiteLLM
LITELLM_MASTER_KEY=change-me
STORE_MODEL_IN_DB='True'
TZ='America/Santiago'
DATABASE_URL='postgresql://llmproxy:change-me@db:5432/litellm'
MY_REDIS_PASSWORD=change-me

# Proveedores
AWS_BEARER_TOKEN_BEDROCK=change-me
AWS_REGION_NAME='us-east-1'
CANOPY_WAVE_API_KEY=change-me
CANOPY_WAVE_API_KEY_FAST=change-me
CLINE_API_KEY=change-me
CLIPROXYAPI_API_KEY=change-me
DEEPSEEK_API_KEY=change-me
EXA_API_KEY=change-me
KILO_2_API_KEY=change-me
KILO_GATEWAY_API_KEY=change-me
OMNIROUTE_API_KEY=change-me
OPENROUTER_API_KEY=change-me
XIAOMI_API_KEY=change-me
GITHUB_COPILOT_TOKEN_DIR='~/.config/litellm/github_copilot'
GITHUB_COPILOT_ACCESS_TOKEN_FILE='access-token'
GITHUB_COPILOT_API_KEY_FILE='api-key.json'

# PostgreSQL
POSTGRES_DB='litellm'
POSTGRES_USER='llmproxy'
POSTGRES_PASSWORD=change-me

# Redis (requirepass del servidor)
REDIS_PASSWORD=change-me
