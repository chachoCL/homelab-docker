# blinko — plantilla (copiar a .env y completar)

# Blinko
NODE_ENV='production'
NEXTAUTH_URL='https://keep.joseluna.dev'
NEXT_PUBLIC_BASE_URL='https://keep.joseluna.dev'
NEXTAUTH_SECRET=change-me
DATABASE_URL='postgresql://postgres:change-me@postgres:5432/postgres'
S3_FORCE_PATH_STYLE='true'
SPOTIFY_CLIENT_ID=change-me
SPOTIFY_CLIENT_SECRET=change-me

# PostgreSQL
POSTGRES_DB='postgres'
POSTGRES_USER='postgres'
POSTGRES_PASSWORD=change-me
TZ='America/Santiago'
