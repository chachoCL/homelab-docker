services:
  excalidraw:
    image: excalidraw/excalidraw:latest
    container_name: excalidraw
    networks:
      - excalidraw
      - proxy
  #  ports:
  #    - "80:80"
    restart: always
    labels:
      - sablier.enable=true
      - sablier.group=excalidraw

  excalidraw-room:
    image: excalidraw/excalidraw-room:latest
    container_name: excalidraw-room
    networks:
      - excalidraw
      - proxy
 #   ports:
 #     - "5000:80"
    restart: always
    labels:
      - sablier.enable=true
      - sablier.group=excalidraw

networks:
  excalidraw:
    external: true
  proxy:
    external: true
